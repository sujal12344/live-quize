{
  "name": "live-quize",
  "version": "1.0.0",
  "description": "",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -c \"cyan,green\" -n \"server,client\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "node --check server/db.js && node --check server/quizStore.js && node --check server/socketHandlers.js && node --check server/index.js",
    "build:client": "cd client && npm install && npm run build",
    "build": "npm run build:server && npm run build:client",
    "postinstall": "cd client && npm install",
    "start": "node server/index.js"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": ["server"],
    "ext": "js,json",
    "ignore": ["client/*", "*.db*", ".git/*"],
    "delay": 1000
  }
}
